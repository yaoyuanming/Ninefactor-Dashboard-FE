# K8s 部署时的环境变量占位符配置
# 这些占位符会在容器启动时被 replace-env.sh 脚本替换为实际的环境变量值

# 项目标题
VITE_APP_TITLE=__VITE_APP_TITLE__

# 项目运行端口
VITE_PORT=__VITE_PORT__

# 请求基础路径（API 前缀）
VITE_API_BASE_URL=__VITE_API_BASE_URL__

# 文件上传类型
VITE_UPLOAD_TYPE=__VITE_UPLOAD_TYPE__

# 上传文件接口地址
VITE_UPLOAD_API_URL=__VITE_UPLOAD_API_URL__

# 租户开关
VITE_APP_TENANT_ENABLE=__VITE_APP_TENANT_ENABLE__

# 验证码开关
VITE_APP_CAPTCHA_ENABLE=__VITE_APP_CAPTCHA_ENABLE__

# 文档地址开关
VITE_APP_DOCALERT_ENABLE=__VITE_APP_DOCALERT_ENABLE__

# GoView 域名
VITE_GOVIEW_URL=__VITE_GOVIEW_URL__

# 默认登录账户密码
VITE_APP_DEFAULT_LOGIN_TENANT=__VITE_APP_DEFAULT_LOGIN_TENANT__
VITE_APP_DEFAULT_LOGIN_USERNAME=__VITE_APP_DEFAULT_LOGIN_USERNAME__
VITE_APP_DEFAULT_LOGIN_PASSWORD=__VITE_APP_DEFAULT_LOGIN_PASSWORD__
